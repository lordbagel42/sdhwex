{
  "manifest_version": 3,
  "name": "sdhwex",
  "version": "1.3.0",
  "description": "Hardware review findings and reasons, automatically refreshed from Cloudflare with an offline fallback.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://sdhwex-data.enderium42.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://stardance.hackclub.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
